# Copy to .env.local and fill in the real values.

# --- Supabase (auth, DB, realtime) ---
# Both are PUBLIC client-side keys — safe to ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Cloudinary (media uploads — images + video) ---
# Both are PUBLIC. The upload preset must be UNSIGNED (Cloudinary dashboard
# → Settings → Upload → Add upload preset → Signing Mode: Unsigned).
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# --- ALATPay (deposits / Add funds) ---
# PUBLIC client keys for the hosted popup (Settings → Business → View in the
# ALATPay merchant portal). The secret subscription key + service crediting
# live ONLY in the Edge Functions (see below) — never ship those here.
VITE_ALATPAY_BUSINESS_ID=your-alatpay-business-id
VITE_ALATPAY_API_KEY=your-alatpay-api-key
#
# Crediting happens server-side from ALATPay's callback (no requery / no
# subscription key needed). Edge Function secret (set with `supabase secrets
# set ...`, NOT here):
#   ALATPAY_BUSINESS_ID   same value as VITE_ALATPAY_BUSINESS_ID (anti-forgery check)
# Deploy the webhook (public — ALATPay sends no Supabase JWT):
#   npx supabase functions deploy alatpay-webhook --no-verify-jwt --project-ref <ref>
#   npx supabase secrets set ALATPAY_BUSINESS_ID=<your-business-id> --project-ref <ref>
# Then set the Callback/Webhook URL in the ALATPay portal (Business settings) to:
#   https://<project-ref>.supabase.co/functions/v1/alatpay-webhook

# --- FX rates (local-currency display) ---
# The wallet settles in NGN; for display we show each user their local
# currency using daily USD-based rates. The ExchangeRate-API key stays
# server-side (Edge Function secret) — never in the browser:
#   npx supabase functions deploy fx-rates --project-ref <ref>
#   npx supabase secrets set EXCHANGERATE_API_KEY=<your-key> --project-ref <ref>

# --- Email notifications (notify-email Edge Function, Gmail SMTP app password) ---
# Sent by the notify-email function over Gmail SMTP. Set as function SECRETS
# (not shipped to browser):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465
#   SMTP_USER=you@gmail.com    SMTP_PASS=<gmail app password, 16 chars no spaces>
#   SMTP_FROM="Love meet <you@gmail.com>"
#   NOTIFY_EMAIL_SECRET=<long random string>   APP_URL=https://your-app-url
# Deploy + secrets:
#   npx supabase functions deploy notify-email --no-verify-jwt --project-ref <ref>
#   npx supabase secrets set SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=... SMTP_PASS=... SMTP_FROM=... NOTIFY_EMAIL_SECRET=... APP_URL=... --project-ref <ref>
# Then create a Database Webhook (Dashboard → Database → Webhooks):
#   Table: public.notifications · Events: Insert · Type: HTTP Request (POST)
#   URL: https://<ref>.supabase.co/functions/v1/notify-email
#   HTTP header: x-webhook-secret: <same NOTIFY_EMAIL_SECRET>

# --- Adsterra (in-feed ads for free-mode users) ---
# Create a "Banner 300x250" ad unit in the Adsterra publisher dashboard and
# paste its key here. PUBLIC. Leave unset to disable ads entirely.
VITE_ADSTERRA_BANNER_KEY=your-adsterra-300x250-key
